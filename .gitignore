# CMake build output, wherever it is. An example builds under its own directory,
# so a rule anchored at the root would leave every example's output tracked — and
# once a build directory is in the index, a later rule does not take it back out.
build/
build-*/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile

# Generated configuration and staging output
/generated/
/stage/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/

# Test and coverage output
Testing/
coverage/
*.gcda
*.gcno
*.gcov

# Local IDE and OS files
.vscode/
.idea/
.DS_Store

# The vendor's HAL and CMSIS sources, assembled by the toolchain for a build.
# They are fetched into the toolchain's cache and are not part of this module: a
# checkout does not carry them, and a build brings the ones its preset names.
vendor/
