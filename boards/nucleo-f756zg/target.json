{
  "kind": "board",
  "name": "nucleo-f756zg",
  "comment": "A Nucleo-144 board carrying a STM32F756, built against the STM32F7 sources and linked for this part's memory. Programmed through the ST-LINK already on the board.",
  "board": "NUCLEO-F756ZG",
  "mcu": "stm32f756xx",
  "core": "cortex-m7",
  "arch": "arm-cortex-m",
  "preset": "stm32f7",
  "toolchain": {
    "compiler": "arm-none-eabi-gcc",
    "linker": "arm-none-eabi-gcc",
    "objcopy": "arm-none-eabi-objcopy",
    "size": "arm-none-eabi-size",
    "flags": [
      "-mcpu=cortex-m7",
      "-mthumb",
      "-ffunction-sections",
      "-fdata-sections"
    ]
  },
  "defines": [
    "USE_PWR_LDO_SUPPLY",
    "STM32F756xx",
    "ROBOHUB_STM32_HAL_HEADER=\"stm32f7xx_hal.h\"",
    "HSE_VALUE=25000000",
    "HSE_STARTUP_TIMEOUT=100",
    "HSI_VALUE=16000000",
    "USE_HAL_DRIVER"
  ],
  "flags": [
    "-nostartfiles",
    "-Wl,--gc-sections",
    "-specs=nano.specs",
    "-specs=nosys.specs"
  ],
  "flash": {
    "tool": "openocd",
    "command": "openocd -f interface/stlink.cfg -f target/stm32f7x.cfg -c \"program {binary} verify reset exit\"",
    "comment": "Flashing reaches the part through the ST-LINK, which every Nucleo-144 board carries"
  },
  "pins": {
    "CONSOLE_TX": {
      "port": "GPIOD",
      "pin": 8,
      "comment": "Connected to the ST-LINK virtual COM port"
    },
    "CONSOLE_RX": {
      "port": "GPIOD",
      "pin": 9
    },
    "LED_GREEN": {
      "port": "GPIOB",
      "pin": 0,
      "comment": "LD1, the user green LED"
    },
    "LED_YELLOW": {
      "port": "GPIOB",
      "pin": 7,
      "comment": "LD2, the user yellow LED"
    },
    "LED_RED": {
      "port": "GPIOB",
      "pin": 14,
      "comment": "LD3, the user red LED"
    }
  }
}
