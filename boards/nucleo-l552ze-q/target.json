{
  "name": "nucleo-l552ze-q",
  "board": "nucleo-l552ze-q",
  "mcu": "stm32l552zexx",
  "family": "stm32l5",
  "console": {
    "instance": "LPUART1",
    "baud": 115200,
    "tx": {
      "port": "GPIOG",
      "pin": "GPIO_PIN_7",
      "af": "GPIO_AF8_LPUART1"
    },
    "rx": {
      "port": "GPIOG",
      "pin": "GPIO_PIN_8",
      "af": "GPIO_AF8_LPUART1"
    },
    "clock": {
      "has_periph_clk": true,
      "periph": "RCC_PERIPHCLK_LPUART1",
      "source_field": "Lpuart1ClockSelection",
      "source_val": "RCC_LPUART1CLKSOURCE_HSI"
    }
  },
  "leds": {
    "green": {
      "port": "GPIOB",
      "pin": "GPIO_PIN_0"
    },
    "yellow": {
      "port": "GPIOB",
      "pin": "GPIO_PIN_14"
    },
    "blue": {
      "port": "GPIOC",
      "pin": "GPIO_PIN_7"
    }
  }
}
